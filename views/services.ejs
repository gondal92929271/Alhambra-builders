<%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero-section services-hero">
    <div class="hero-content">
      <h1 class="animate__animated animate__fadeIn">Our Services</h1>
      <p class="animate__animated animate__fadeIn animate__delay-1s">Quality Construction & Renovation Services in Manchester</p>
    </div>
  </section>

  <!-- Services Content -->
  <section class="services-content container mt-2">
    <div class="intro-text">
      <p>At Alhamra Builders, we offer a comprehensive range of construction and renovation services to homeowners across Manchester and surrounding areas. From small-scale renovations to complete home transformations, our team of skilled professionals is committed to delivering exceptional quality and customer satisfaction on every project.</p>
    </div>
    
    <!-- Services List -->
    <div class="services-list">
      <!-- Home Extensions -->
      <div id="extensions" class="service-item">
        <div class="service-image">
          <img src="/images/Home Extensions.jpg" alt="Home Extension in Manchester">
        </div>
        <div class="service-details">
          <h2>Home Extensions</h2>
          <p>Create additional living space and add value to your property with our bespoke home extension services. Whether you're looking for a single-storey rear extension, side return, or a more complex multi-storey addition, our team will work with you to design and build an extension that seamlessly integrates with your existing property.</p>
          <h3>Our Extension Services Include:</h3>
          <ul>
            <li>Single-storey extensions</li>
            <li>Double-storey extensions</li>
            <li>Rear and side extensions</li>
            <li>Kitchen extensions</li>
            <li>Wraparound extensions</li>
          </ul>
          <a href="/quote" class="btn">Get a Quote</a>
        </div>
      </div>
      
      <!-- Loft Conversions -->
      <div id="loft-conversions" class="service-item">
        <div class="service-details">
          <h2>Loft Conversions</h2>
          <p>Transform your unused attic space into a functional living area with our expert loft conversion services. Whether you're looking to create an additional bedroom, home office, or recreational space, we'll help you maximize your home's potential while adding significant value to your property.</p>
          <h3>Types of Loft Conversions:</h3>
          <ul>
            <li>Dormer loft conversions</li>
            <li>Hip-to-gable conversions</li>
            <li>Mansard conversions</li>
            <li>Velux/roof light conversions</li>
          </ul>
          <a href="/quote" class="btn">Get a Quote</a>
        </div>
        <div class="service-image">
          <img src="/images/Loft Conversions.jpg" alt="Loft Conversion in Manchester">
        </div>
      </div>
      
      <!-- Renovations -->
      <div id="renovations" class="service-item">
        <div class="service-image">
          <img src="/images/Home Renovations.jpg" alt="Home Renovation in Manchester">
        </div>
        <div class="service-details">
          <h2>Home Renovations</h2>
          <p>Breathe new life into your property with our comprehensive renovation services. From updating a single room to completely transforming your entire home, our skilled team will help you create a space that reflects your style and meets your needs.</p>
          <h3>Our Renovation Services Include:</h3>
          <ul>
            <li>Kitchen renovations</li>
            <li>Bathroom renovations</li>
            <li>Full house renovations</li>
            <li>Period property restorations</li>
            <li>Open-plan living conversions</li>
          </ul>
          <a href="/quote" class="btn">Get a Quote</a>
        </div>
      </div>
      
      <!-- New Builds -->
      <div id="new-builds" class="service-item">
        <div class="service-details">
          <h2>New Builds</h2>
          <p>From single dwellings to small-scale developments, our experienced team can handle your new build project from concept to completion. We work closely with architects and planning authorities to ensure your new build meets all requirements while delivering on your vision.</p>
          <h3>Our New Build Services Include:</h3>
          <ul>
            <li>Custom home builds</li>
            <li>Small residential developments</li>
            <li>Eco-friendly construction</li>
            <li>Modern and traditional designs</li>
          </ul>
          <a href="/quote" class="btn">Get a Quote</a>
        </div>
        <div class="service-image">
          <img src="/images/New Builds.jpg" alt="New Build in Manchester">
        </div>
      </div>
      
      <!-- ECO4 Grants -->
      <div id="eco4" class="service-item">
        <div class="service-image">
          <img src="/images/ECO4 Grant Services.jpg" alt="ECO4 Energy Efficiency Improvements">
        </div>
        <div class="service-details">
          <h2>ECO4 Grant Services</h2>
          <p>Improve your home's energy efficiency and reduce your carbon footprint with our ECO4 grant services. We can help eligible homeowners access government funding for various energy-saving improvements.</p>
          <h3>Available ECO4 Improvements:</h3>
          <ul>
            <li>Cavity wall insulation</li>
            <li>Loft insulation</li>
            <li>Solid wall insulation</li>
            <li>Heating system upgrades</li>
            <li>Renewable energy solutions</li>
          </ul>
          <a href="/eco4" class="btn">Learn More About ECO4</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="process-section mt-2">
    <div class="container">
      <h2 class="section-title">Our Process</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3>Initial Consultation</h3>
          <p>We discuss your project requirements, budget, and timeline to understand your vision.</p>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <h3>Design & Planning</h3>
          <p>Our team creates detailed plans and obtains necessary permissions for your project.</p>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <h3>Construction</h3>
          <p>Our skilled craftsmen bring your project to life with quality materials and workmanship.</p>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <h3>Completion & Handover</h3>
          <p>We ensure everything meets our high standards before handing over your finished project.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call-to-Action Banner -->
  <section class="cta-banner mt-2">
    <div class="container">
      <h2>Ready to start your project?</h2>
      <a href="/quote" class="btn">Request a Free Quote</a>
    </div>
  </section>

<%- include('partials/footer') %>
