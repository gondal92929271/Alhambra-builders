<%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero-section about-hero">
    <div class="hero-content">
      <h1 class="animate__animated animate__fadeIn">About Alhamra Builders</h1>
      <p class="animate__animated animate__fadeIn animate__delay-1s">Manchester's Trusted Home Construction Specialists</p>
    </div>
  </section>

  <!-- About Content -->
  <section class="about-content container mt-2">
    <div class="about-grid">
      <div class="about-text">
        <h2>Our Story</h2>
        <p>Alhamra Builders was founded in 2010 with a simple mission: to provide Manchester homeowners with high-quality construction services that combine traditional craftsmanship with modern building techniques.</p>
        <p>Over the past decade, we've grown from a small team handling minor renovations to becoming one of Manchester's most trusted building companies, specializing in extensions, loft conversions, and complete home renovations.</p>
        <p>What sets us apart is our commitment to quality, transparency, and customer satisfaction. We believe in building not just structures, but relationships with our clients that last well beyond project completion.</p>
        
        <h2 class="mt-1">Our Approach</h2>
        <p>At Alhamra Builders, we take a collaborative approach to every project. We work closely with homeowners to understand their vision, provide expert advice, and deliver solutions that exceed expectations while respecting budgets and timelines.</p>
        <p>Our process is transparent from start to finish. From the initial consultation to the final walkthrough, we keep clients informed and involved, ensuring there are no surprises along the way.</p>
      </div>
      <div class="about-image">
        <img src="/images/team-at-work.jpg" alt="Alhamra Builders team at work" class="rounded-image">
      </div>
    </div>
    
    <!-- Team Section -->
    <div class="team-section mt-2">
      <h2>Our Team</h2>
      <p>Our team consists of experienced builders, skilled craftsmen, and dedicated project managers who share a passion for quality construction and customer satisfaction.</p>
      <div class="team-grid">
        <div class="team-member">
          <div class="team-photo">
            <img src="/images/Ahmed%20Khan.jpg" alt="Ahmed Khan - Founder & Director" loading="lazy">
          </div>
          <h3>Mohammad Asghar Gondal</h3>
          <p>Founder & Director</p>
        </div>
        <div class="team-member">
          <div class="team-photo dummy">
            SJ
          </div>
          <h3>Ahmed Rafay</h3>
          <p>Project Manager</p>
        </div>
        <div class="team-member">
          <div class="team-photo">
            <img src="/images/Michael%20Thompson.jpg" alt="Michael Thompson - Lead Builder" loading="lazy">
          </div>
          <h3>Touseef Ahmed</h3>
          <p>Lead Builder</p>
        </div>
        <div class="team-member">
          <div class="team-photo dummy">
            FA
          </div>
          <h3>Fahad Ilyas</h3>
          <p>Interior Designer</p>
        </div>
      </div>
    </div>
    
    <!-- Credentials Section -->
    <div class="credentials-section mt-2">
      <h2>Our Credentials</h2>
      <div class="credentials-grid">
        <div class="credential-item">
          <i class="fas fa-certificate"></i>
          <h3>Fully Insured</h3>
          <p>Comprehensive liability insurance for all projects</p>
        </div>
        <div class="credential-item">
          <i class="fas fa-hard-hat"></i>
          <h3>Health & Safety Compliant</h3>
          <p>Strict adherence to all safety regulations</p>
        </div>
        <div class="credential-item">
          <i class="fas fa-award"></i>
          <h3>Quality Guaranteed</h3>
          <p>10-year warranty on all major structural work</p>
        </div>
        <div class="credential-item">
          <i class="fas fa-users"></i>
          <h3>Federation of Master Builders</h3>
          <p>Proud member of the FMB</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call-to-Action Banner -->
  <section class="cta-banner mt-2">
    <div class="container">
      <h2>Ready to start your project with us?</h2>
      <a href="/quote" class="btn">Request a Free Quote</a>
    </div>
  </section>

<%- include('partials/footer') %>
