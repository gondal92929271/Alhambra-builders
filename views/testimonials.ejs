<%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero-section testimonials-hero">
    <div class="hero-content">
      <h1 class="animate__animated animate__fadeIn">Client Testimonials</h1>
      <p class="animate__animated animate__fadeIn animate__delay-1s">What Our Customers Say About Us</p>
    </div>
  </section>

