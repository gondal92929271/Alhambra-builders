    <!-- Testimonials Grid -->
    <div class="testimonials-grid">
      <!-- Testimonial 1 -->
      <div class="testimonial-card">
        <div class="testimonial-content">
          <blockquote>"Alhamra Builders completed our kitchen extension on time and within budget. The team was professional, courteous, and the quality of work was exceptional. We couldn't be happier with our new space!"</blockquote>
        </div>
        <div class="testimonial-author">
          <div class="author-image dummy">
            SD
          </div>
          <div class="author-info">
            <h3>Sarah & John Davies</h3>
            <p>Kitchen Extension, Swinton</p>
            <div class="rating">
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
            </div>
          </div>
        </div>
      </div>
      
