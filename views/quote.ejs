<%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero-section quote-hero">
    <div class="hero-content">
      <h1 class="animate__animated animate__fadeIn">Request a Free Quote</h1>
      <p class="animate__animated animate__fadeIn animate__delay-1s">Get Started on Your Home Improvement Journey</p>
    </div>
  </section>

  <!-- Quote Content -->
  <section class="quote-content container mt-2">
    <div class="intro-text">
      <p>Fill out the form below to request a free, no-obligation quote for your project. Our team will review your requirements and get back to you within 24-48 hours to discuss next steps.</p>
    </div>
    
    <!-- Quote Form -->
    <div class="quote-form-container">
      <form action="/submit-quote" method="post" class="quote-form">
        <!-- Personal Information -->
        <div class="form-section">
          <h2>Personal Information</h2>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" required>
            </div>
            <div class="form-group">
              <label for="address">Property Address</label>
              <input type="text" id="address" name="address" required>
            </div>
          </div>
        </div>
        
        <!-- Project Details -->
        <div class="form-section">
          <h2>Project Details</h2>
          <div class="form-group">
            <label for="project_type">Project Type</label>
            <select id="project_type" name="project_type" required>
              <option value="">Select Project Type</option>
              <option value="extension">Home Extension</option>
              <option value="loft_conversion">Loft Conversion</option>
              <option value="renovation">Home Renovation</option>
              <option value="kitchen">Kitchen Renovation</option>
              <option value="bathroom">Bathroom Renovation</option>
              <option value="eco4">ECO4 Energy Improvements</option>
              <option value="other">Other (Please Specify)</option>
            </select>
          </div>
          <div class="form-group" id="other_project_container" style="display: none;">
            <label for="other_project">Please Specify Project Type</label>
            <input type="text" id="other_project" name="other_project">
          </div>
          <div class="form-group">
            <label for="project_description">Project Description</label>
            <textarea id="project_description" name="project_description" rows="5" required></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="budget">Estimated Budget (£)</label>
              <select id="budget" name="budget">
                <option value="">Select Budget Range</option>
                <option value="under_10k">Under £10,000</option>
                <option value="10k_25k">£10,000 - £25,000</option>
                <option value="25k_50k">£25,000 - £50,000</option>
                <option value="50k_100k">£50,000 - £100,000</option>
                <option value="over_100k">Over £100,000</option>
                <option value="not_sure">Not Sure</option>
              </select>
            </div>
            <div class="form-group">
              <label for="timeframe">Desired Timeframe</label>
              <select id="timeframe" name="timeframe">
                <option value="">Select Timeframe</option>
                <option value="asap">As Soon As Possible</option>
                <option value="1_3_months">1-3 Months</option>
                <option value="3_6_months">3-6 Months</option>
                <option value="6_12_months">6-12 Months</option>
                <option value="not_sure">Not Sure</option>
              </select>
            </div>
          </div>
        </div>
        
        <!-- Additional Information -->
        <div class="form-section">
          <h2>Additional Information</h2>
          <div class="form-group">
            <label for="additional_info">Any other details you'd like to share about your project?</label>
            <textarea id="additional_info" name="additional_info" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label for="hear_about_us">How did you hear about us?</label>
            <select id="hear_about_us" name="hear_about_us">
              <option value="">Select Option</option>
              <option value="referral">Referral from Friend/Family</option>
              <option value="google">Google Search</option>
              <option value="social_media">Social Media</option>
              <option value="previous_customer">Previous Customer</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        
        <!-- Submit Button -->
        <div class="form-submit">
          <button type="submit" class="btn btn-primary">Submit Quote Request</button>
        </div>
      </form>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message">
          <p>Thank you for your quote request. We'll be in touch within 24-48 hours to discuss your project.</p>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message">
          <% if (error === 'missing_fields') { %>
            <p>Please fill in all required fields.</p>
          <% } else if (error === 'email_failed') { %>
            <p>Sorry, there was an error sending your quote request. Please try again or call us directly.</p>
          <% } else { %>
            <p>An error occurred. Please try again later.</p>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="what-to-expect mt-2">
    <div class="container">
      <h2 class="section-title">What to Expect Next</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <h3>Initial Contact</h3>
          <p>We'll call or email you within 24-48 hours to discuss your project requirements.</p>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <h3>Site Visit</h3>
          <p>We'll arrange a convenient time to visit your property and assess the project scope.</p>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <h3>Detailed Quote</h3>
          <p>We'll provide a comprehensive written quote outlining costs, timelines, and specifications.</p>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <h3>Project Planning</h3>
          <p>Once you're happy to proceed, we'll schedule your project and begin the planning process.</p>
        </div>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
