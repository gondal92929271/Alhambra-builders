<%- include('partials/header') %>

  <!-- Hero Section -->
  <section class="hero-section projects-hero">
    <div class="hero-content">
      <h1 class="animate__animated animate__fadeIn">Our Projects</h1>
      <p class="animate__animated animate__fadeIn animate__delay-1s">Showcasing Our Quality Craftsmanship Across Manchester</p>
    </div>
  </section>

  <!-- Projects Content -->
  <section class="projects-content container mt-2">
    <div class="intro-text">
      <p>Browse through our portfolio of completed projects across Manchester and surrounding areas. Each project demonstrates our commitment to quality, attention to detail, and customer satisfaction.</p>
    </div>
    
    <!-- Projects Grid -->
    <div class="projects-grid">
      <!-- Project 1 -->
      <div id="project1" class="project-card">
        <div class="project-image">
          <img src="/images/Modern Kitchen Extension.jpg" alt="Modern Kitchen Extension – Swinton">
        </div>
        <div class="project-info">
          <h2>Modern Kitchen Extension</h2>
          <p class="project-location">Swinton, Manchester</p>
          <p class="project-description">A contemporary single-storey rear extension creating a spacious open-plan kitchen and dining area with bi-fold doors opening onto the garden.</p>
          <div class="project-details">
            <div class="detail-item">
              <span class="detail-label">Project Type:</span>
              <span class="detail-value">Kitchen Extension</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Duration:</span>
              <span class="detail-value">12 Weeks</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Features:</span>
              <span class="detail-value">Bi-fold doors, Skylight, Open-plan design</span>
            </div>
          </div>
          <button class="btn view-project" data-project="project1">View Project Details</button>
        </div>
      </div>
      
      <!-- Project 2 -->
      <div id="project2" class="project-card">
        <div class="project-image">
          <img src="/images/Dormer Loft Conversion.jpg" alt="Dormer Loft Conversion – Didsbury">
        </div>
        <div class="project-info">
          <h2>Dormer Loft Conversion</h2>
          <p class="project-location">Didsbury, Manchester</p>
          <p class="project-description">A spacious dormer loft conversion creating a master bedroom with ensuite bathroom and built-in storage, maximizing the available space.</p>
          <div class="project-details">
            <div class="detail-item">
              <span class="detail-label">Project Type:</span>
              <span class="detail-value">Loft Conversion</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Duration:</span>
              <span class="detail-value">8 Weeks</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Features:</span>
              <span class="detail-value">Ensuite bathroom, Built-in storage, Velux windows</span>
            </div>
          </div>
          <button class="btn view-project" data-project="project2">View Project Details</button>
        </div>
      </div>
      
      <!-- Project 3 -->
      <div id="project3" class="project-card">
        <div class="project-image">
          <img src="/images/Full Home Renovation.jpg" alt="Full Home Renovation – Bolton">
        </div>
        <div class="project-info">
          <h2>Full Home Renovation</h2>
          <p class="project-location">Bolton</p>
          <p class="project-description">A complete renovation of a 3-bedroom semi-detached property, including new kitchen, bathroom, rewiring, replumbing, and interior design.</p>
          <div class="project-details">
            <div class="detail-item">
              <span class="detail-label">Project Type:</span>
              <span class="detail-value">Full Renovation</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Duration:</span>
              <span class="detail-value">16 Weeks</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Features:</span>
              <span class="detail-value">New kitchen, New bathroom, Full rewiring, New heating system</span>
            </div>
          </div>
          <button class="btn view-project" data-project="project3">View Project Details</button>
        </div>
      </div>
      
      <!-- Project 4 -->
      <div id="project4" class="project-card">
        <div class="project-image">
          <img src="/images/Two-Storey Side Extension.jpg" alt="Two-Storey Side Extension – Stockport">
        </div>
        <div class="project-info">
          <h2>Two-Storey Side Extension</h2>
          <p class="project-location">Stockport</p>
          <p class="project-description">A two-storey side extension adding a ground floor utility room and WC, with an additional bedroom and bathroom on the first floor.</p>
          <div class="project-details">
            <div class="detail-item">
              <span class="detail-label">Project Type:</span>
              <span class="detail-value">Side Extension</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Duration:</span>
              <span class="detail-value">14 Weeks</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Features:</span>
              <span class="detail-value">Utility room, Additional bedroom, New bathroom</span>
            </div>
          </div>
          <button class="btn view-project" data-project="project4">View Project Details</button>
        </div>
      </div>
      
      <!-- Project 5 -->
      <div id="project5" class="project-card">
        <div class="project-image">
          <img src="/images/Kitchen Renovation.jpg" alt="Kitchen Renovation – Chorlton">
        </div>
        <div class="project-info">
          <h2>Kitchen Renovation</h2>
          <p class="project-location">Chorlton, Manchester</p>
          <p class="project-description">A complete kitchen renovation with custom cabinetry, quartz countertops, and high-end appliances, creating a modern cooking and entertaining space.</p>
          <div class="project-details">
            <div class="detail-item">
              <span class="detail-label">Project Type:</span>
              <span class="detail-value">Kitchen Renovation</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Duration:</span>
              <span class="detail-value">4 Weeks</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Features:</span>
              <span class="detail-value">Custom cabinetry, Quartz countertops, Island with seating</span>
            </div>
          </div>
          <button class="btn view-project" data-project="project5">View Project Details</button>
        </div>
      </div>
      
      <!-- Project 6 -->
      <div id="project6" class="project-card">
        <div class="project-image">
          <img src="/images/Bathroom Remodel.jpg" alt="Bathroom Remodel – Sale">
        </div>
        <div class="project-info">
          <h2>Bathroom Remodel</h2>
          <p class="project-location">Sale, Manchester</p>
          <p class="project-description">A luxury bathroom remodel featuring a walk-in shower, freestanding bath, and bespoke vanity unit with underfloor heating throughout.</p>
          <div class="project-details">
            <div class="detail-item">
              <span class="detail-label">Project Type:</span>
              <span class="detail-value">Bathroom Remodel</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Duration:</span>
              <span class="detail-value">3 Weeks</span>
            </div>
            <div class="detail-item">
              <span class="detail-label">Features:</span>
              <span class="detail-value">Walk-in shower, Freestanding bath, Underfloor heating</span>
            </div>
          </div>
          <button class="btn view-project" data-project="project6">View Project Details</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Call-to-Action Banner -->
  <section class="cta-banner mt-2">
    <div class="container">
      <h2>Ready to start your own project?</h2>
      <a href="/quote" class="btn">Request a Free Quote</a>
    </div>
  </section>

<%- include('partials/footer') %>
